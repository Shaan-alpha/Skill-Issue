# Skill Issue — Backend Environment Variables

# GitHub Personal Access Token (classic or fine-grained)
# Required for ingestion and high rate limits.
GITHUB_TOKEN=your_github_token_here

# OpenAI API Key
# Required for v0.3.0+ (Roast Mode / Mentor Mode)
OPENAI_API_KEY=your_openai_key_here

# v0.5.0 — Auth + persistence
DATABASE_URL=postgresql+asyncpg://user:password@host-pooler.aws.neon.tech:6543/dbname
DATABASE_DIRECT_URL=postgresql+asyncpg://user:password@host.aws.neon.tech:5432/dbname
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8000/auth/callback
# Generate with: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SESSION_TOKEN_ENC_KEY=
# Optional (auto-derived in prod):
# COOKIE_DOMAIN=skillissue.app
# COOKIE_SECURE=true
