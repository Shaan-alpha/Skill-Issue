# Skill Issue — Backend Environment Variables
#
# Copy to .env and fill in the values you need. Anything you leave blank
# falls through to a sensible default (or disables the feature locally).

# ── GitHub ────────────────────────────────────────────────────────────
# Personal Access Token (classic or fine-grained). Required for /analyze.
# Signed-in users use their own OAuth token; this is the fallback for
# anonymous traffic.
GITHUB_TOKEN=your_github_token_here

# ── Narrative LLM (Roast + Mentor) ────────────────────────────────────
# OpenAI-compatible API key. Use a Groq key when NARRATIVE_BASE_URL points
# at Groq (the production default).
OPENAI_API_KEY=your_openai_or_groq_key_here

# Optional OpenAI-compatible base URL. Empty = OpenAI. Set to Groq for
# the production default.
NARRATIVE_BASE_URL=https://api.groq.com/openai/v1
NARRATIVE_MODEL=llama-3.3-70b-versatile

# Optional per-day request budget (default 50). Counted via Upstash when
# configured so it's shared across instances; otherwise in-process.
# NARRATIVE_DAILY_LIMIT=50

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Default: http://localhost:3000.
# CORS_ALLOW_ORIGINS=http://localhost:3000

# Optional regex for preview-deploy URLs.
# CORS_ALLOW_ORIGIN_REGEX=https://skill-issue(-[a-z0-9-]+)?\.vercel\.app

# ── v0.5.0: Auth + persistence ────────────────────────────────────────
# Neon Postgres URLs. Pooled (6543) for runtime, direct (5432) for Alembic.
DATABASE_URL=postgresql+asyncpg://user:password@host-pooler.aws.neon.tech:6543/dbname
DATABASE_DIRECT_URL=postgresql+asyncpg://user:password@host.aws.neon.tech:5432/dbname

# GitHub OAuth App (https://github.com/settings/developers).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8000/auth/callback

# AES-GCM key for at-rest GitHub-token encryption. 32 bytes, base64.
# Generate with:
#   python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SESSION_TOKEN_ENC_KEY=

# Optional cookie tweaks. COOKIE_SECURE defaults to true (fail closed) — set
# it to false ONLY for local HTTP dev, or the browser won't send the session
# cookie over http://localhost and login will silently fail.
# COOKIE_DOMAIN=skillissue.app
# COOKIE_SECURE=false  # local HTTP dev only — leave commented so the fail-closed default wins

# ── v0.7.0: Upstash Redis cache ───────────────────────────────────────
# Both vars come from https://console.upstash.com → your DB → REST API.
# Leave blank for local dev — the backend short-circuits every cache
# integration and falls back to today's behaviour. No code change needed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional TTL overrides (defaults: 21600s = 6h for Report, 900s = 15min
# fallback for layers without a per-endpoint match).
# CACHE_REPORT_TTL_SECONDS=21600
# CACHE_DEFAULT_TTL_SECONDS=900

# ── v0.8.1: cron auth ─────────────────────────────────────────────────
# Bearer token guarding the scheduled refresh cron. Vercel auto-injects
# "Authorization: Bearer ${CRON_SECRET}" on the cron request when this is
# set on the project. REQUIRED for the daily refresh-saved-analyses job:
# unset → the cron route returns 503. Set it locally only to trigger the
# cron by hand. Generate: python -c "import secrets; print(secrets.token_hex(32))"
# CRON_SECRET=

# ── v0.8.6: /share/[slug] ISR revalidation ────────────────────────────
# Backend posts to {FRONTEND_BASE_URL}/api/revalidate after every share
# toggle to bust the per-slug cache tag. Both vars REQUIRED in prod;
# unset = graceful degradation (3600s cacheLife absorbs revocations).
# REVALIDATE_SECRET must match the frontend's process.env value byte for
# byte (constant-time compared on both sides). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# FRONTEND_BASE_URL=https://skill-issue-tau.vercel.app
# REVALIDATE_SECRET=

# ── v0.9.0: ingestion fan-out cap ─────────────────────────────────────
# Per-call asyncio.Semaphore limit applied to GH API requests inside
# ingest_profile. Caps the burst from _enrich_repo_signals (≤20) and
# list_commits (≤10). Default 8. Raise if Layer A cache hit-rate is
# high and you want lower analysis latency; lower if you're hitting
# GitHub secondary rate-limit 403s.
# GH_INGEST_CONCURRENCY=8

# ── v1.0.5: ingest amplification containment ──────────────────────────
# All optional, defaults shown. Bound how much work one /analyze can trigger.
# GH_MAX_CALLS_PER_ANALYSIS=150            # hard cap on live GitHub calls / analysis
# GITHUB_RETRY_AFTER_CEILING_SECONDS=10    # cap on a single Retry-After sleep
# ANALYZE_INGEST_DEADLINE_SECONDS=45       # wall-clock deadline per /analyze

# ── v0.9.2: rate limiting (IP + user) ─────────────────────────────────
# Hourly caps. Anonymous callers limited per-IP; signed-in callers
# per-user (they bring their own GitHub token). All optional — defaults
# shown. Tune in prod without redeploy.
# ANALYZE_ANON_PER_IP_PER_HOUR=20
# ANALYZE_USER_PER_HOUR=60
# NARRATIVE_ANON_PER_IP_PER_HOUR=30
# NARRATIVE_USER_PER_HOUR=90
#
# Shared secret authenticating the Next.js RSC → backend hop so a
# forwarded X-Client-IP can be trusted for proxied anonymous /analyze.
# Set the SAME value on the frontend's process.env.INTERNAL_PROXY_SECRET.
# Unset = anonymous /analyze is NOT IP-limited (real visitors never
# throttled by mistake); narrative + signed-in limits stay active.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# INTERNAL_PROXY_SECRET=

# ── v1.0.4: per-subject LLM budget + spoof-proof client IP + fail-closed ──────
# The LLM budget is a global ceiling PLUS per-subject daily caps, so one IP
# can't drain the day's AI generation for everyone. Client IP is derived from
# x-forwarded-for (Vercel overwrites it to prevent spoofing). When
# INTERNAL_PROXY_SECRET is unset, anon /analyze falls back to a conservative
# shared backstop instead of being unlimited. All optional — defaults shown.
# NARRATIVE_DAILY_LIMIT=500            # global hard ceiling / UTC-day
# NARRATIVE_ANON_IP_DAILY_LIMIT=10     # per anonymous IP / UTC-day
# NARRATIVE_USER_DAILY_LIMIT=40        # per signed-in user / UTC-day
# TRUSTED_CLIENT_IP_HEADER=x-forwarded-for
# ANALYZE_UNATTRIBUTED_PER_HOUR=300    # anon /analyze backstop when secret unset

# ── v0.9.4: DB connection pool sizing ─────────────────────────────────
# SQLAlchemy async engine pool. Optional — defaults shown match the
# previous hardcoded values, so leaving these unset changes nothing.
# Raise only if RUM shows QueuePool timeouts. Ceiling ~105 usable
# connections on the current Neon compute (112 - 7 reserved); on the
# PgBouncer pooler that's buffered by multiplexing, on a direct
# connection keep (pool_size + max_overflow) x peak_instances < 105.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
